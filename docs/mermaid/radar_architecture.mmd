flowchart TD
    subgraph INPUT["Input"]
        T["Raw Text"]
    end

    subgraph ARSE["ARSE — Adaptive Reasoning Semantic Encoder"]
        TOK["ModernBERT-large Tokenizer\n(max_length = 512)"]
        ENC["ModernBERT-large\n(28 layers, hidden = 1024)"]
        CLS["CLS Token Embedding\nh_semantic ∈ ℝ¹⁰²⁴"]
        TOK --> ENC --> CLS
    end

    subgraph SLPE["SLPE — Statistical Linguistic Profile Extractor"]
        direction TB
        F1["Vocabulary Richness\n(8 features)"]
        F2["Syntactic Complexity\n(10 features)"]
        F3["Discourse Coherence\n(8 features)"]
        F4["Style Fingerprinting\n(7 features)"]
        F5["Perplexity Signals\n(5 features)"]
        SVEC["Style Vector ∈ ℝ³⁸"]
        F1 & F2 & F3 & F4 & F5 --> SVEC
        SPROJ["Style Projection MLP\nLinear → LayerNorm → GELU\nh_style ∈ ℝ¹²⁸"]
        SVEC --> SPROJ
    end

    subgraph FUSION["Cross-Attention Fusion Layer"]
        PROJ2SEM["Linear Projection\nh_style → ℝ¹⁰²⁴"]
        CATTN["Multi-Head Cross-Attention\n(8 heads)\nQuery = h_semantic\nKey/Value = projected style"]
        RESNORM["Residual + LayerNorm"]
        CONCAT["Concatenate\n[attended, h_style] ∈ ℝ¹¹⁵²"]
        FMLP["Fusion MLP\nLinear → LayerNorm → GELU\nh_fused ∈ ℝ⁵¹²"]
        PROJ2SEM --> CATTN
        CATTN --> RESNORM
        RESNORM --> CONCAT
        CONCAT --> FMLP
    end

    subgraph UACC["UACC — Unified Authorship Classification Classifier"]
        CLF["Linear Classifier\nh_fused → logit ∈ ℝ¹"]
        SIG["Sigmoid\nconfidence score ∈ [0,1]"]
        CLF --> SIG
    end

    subgraph OUTPUT["Output"]
        SCORE["Confidence Score\n0 = Human  |  1 = AI"]
    end

    T --> TOK
    T --> F1 & F2 & F3 & F4 & F5

    CLS --> CATTN
    CLS --> CONCAT
    SPROJ --> PROJ2SEM
    SPROJ --> CONCAT

    FMLP --> CLF
    SIG --> SCORE

    style INPUT fill:#f0f4ff,stroke:#4a90e2
    style ARSE fill:#e8f5e9,stroke:#388e3c
    style SLPE fill:#fff3e0,stroke:#f57c00
    style FUSION fill:#fce4ec,stroke:#c62828
    style UACC fill:#ede7f6,stroke:#512da8
    style OUTPUT fill:#f0f4ff,stroke:#4a90e2
