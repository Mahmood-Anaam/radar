flowchart LR
    subgraph PAN26["PAN-2026 Official Data\n(Zenodo)"]
        direction TB
        P_TRAIN["Train Split\n23,707 samples\n(Essays, News, Fiction)"]
        P_VAL["Validation Split\n3,589 samples"]
    end

    subgraph RAID["RAID External Dataset\n(HuggingFace Hub)"]
        direction TB
        R_RAW["5.6M rows\n11 LLMs × 11 Domains\n12 Attack Types"]
        R_FILT["Genre Filter\n(news, books, poetry)\n2.24M rows"]
        R_ATT["Attack Filter\n(none, homoglyph, synonym,\nparaphrase, alt_spelling)\n933K rows"]
        R_SPLIT["Stratified Split 60/40\nDev: 559,860 | Test: 373,240"]
        R_SAMPLE["Balanced Sample\nDev: 30,000 | Test: 10,000"]
        R_RAW --> R_FILT --> R_ATT --> R_SPLIT --> R_SAMPLE
    end

    subgraph PREPROC["Preprocessing"]
        direction TB
        PII["PII Removal\n(email, phone, @mentions)"]
        DEDUP["Deduplication &\nLength Filter (≥50 chars)"]
        LOWER["Lowercasing"]
    end

    subgraph FINAL["Final Splits"]
        direction TB
        TRAIN_F["Combined Train\n38,503 samples\nPAN26(23,682) + RAID-Dev(14,821)"]
        VAL_F["Combined Val\n18,423 samples\nPAN26(3,589) + RAID-Dev(14,834)"]
        TEST_F["Test Set\n10,000 samples\nRAID-Test (balanced 50/50)"]
    end

    P_TRAIN --> PII
    P_VAL --> PII
    R_SAMPLE --> PII
    PII --> DEDUP --> LOWER
    LOWER --> TRAIN_F & VAL_F & TEST_F

    style PAN26 fill:#e8f5e9,stroke:#388e3c
    style RAID fill:#fff3e0,stroke:#f57c00
    style PREPROC fill:#fce4ec,stroke:#c62828
    style FINAL fill:#e3f2fd,stroke:#1565c0
